server {
    listen 80;
    server_name _;
    access_log off;
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 404; }
}
server {
    listen 8787 ssl;
    server_name ${KKUMI_PUBLIC_IP};
    ssl_certificate /etc/letsencrypt/live/kkumikkumi/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kkumikkumi/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:18787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
